SECRET_KEY=change-this-to-a-long-random-secret
PAYMENT_WEBHOOK_SECRET=change-this-payment-webhook-secret
PIX_EXPIRATION_MINUTES=15
PAYMENT_PROVIDER=internal
# Efí Pix homologation - backend only. Never prefix these variables with VITE_.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=/run/secrets/efi_certificate.pem
EFI_PRIVATE_KEY_PATH=/run/secrets/efi_private_key.pem
EFI_PIX_KEY=
EFI_API_BASE_URL=https://pix-h.api.efipay.com.br
# Public HTTPS base; Efí calls this URL with the /pix suffix.
EFI_WEBHOOK_URL=https://example.ngrok.app/api/payment-transactions/provider-webhooks/efi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DB_USER=ilarica_admin
DB_PASSWORD=change-this-password
DB_NAME=ilarica_db
DB_HOST=db
DB_PORT=5432

REDIS_HOST=cache
REDIS_PORT=6379

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development
